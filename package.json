{
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ravidorr"
  },
  "name": "jzb-decoder",
  "version": "1.2.3",
  "private": true,
  "description": "DevTools extension for decoding jzb URL payloads in Chrome, Edge, and Firefox.",
  "license": "MIT",
  "author": "Raanan Avidor",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravidorr/jzb-decoder.git"
  },
  "bugs": {
    "url": "https://github.com/ravidorr/jzb-decoder/issues"
  },
  "homepage": "https://github.com/ravidorr/jzb-decoder#readme",
  "scripts": {
    "prepare": "husky",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html && npm run lint:md",
    "lint:js": "eslint --max-warnings=0 .",
    "lint:css": "stylelint --allow-empty-input --max-warnings=0 \"**/*.css\"",
    "lint:md": "markdownlint-cli2",
    "lint:html": "node scripts/lint-html.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node scripts/run-tests.js && npm run test:release",
    "test:coverage": "node scripts/check-coverage.js && npm run test:release",
    "test:release": "vitest run --config vitest.config.mjs",
    "check:generated": "npm run check-version",
    "check-version": "node scripts/check-version-sync.js",
    "version:patch": "bash scripts/bump-version.sh patch",
    "version:minor": "bash scripts/bump-version.sh minor",
    "version:major": "bash scripts/bump-version.sh major",
    "install-hooks": "bash scripts/install-git-hooks.sh",
    "package": "bash scripts/package.sh",
    "redact-screenshot": "bash scripts/redact-screenshot.sh",
    "validate:security-policy": "node scripts/validate-security-policy-version.mjs",
    "test:security-policy": "node --test scripts/validate-security-policy-version.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@vitest/coverage-v8": "5.0.3",
    "c8": "12.0.0",
    "chrome-types": "0.1.454",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "html-validate": "11.16.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.23.3",
    "semver": "7.8.5",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "overrides": {
    "katex": "0.18.2",
    "smol-toml": "1.9.0"
  }
}
