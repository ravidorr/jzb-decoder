{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": [ "ES2022", "DOM" ],
    "moduleDetection": "force",
    "noEmit": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false
